[Unit]
Description=Local ADS-B decoder and Beast server
After=adsb-initialize.service adsb-firewall.service
Requires=adsb-initialize.service adsb-firewall.service
StartLimitIntervalSec=5min
StartLimitBurst=8

[Service]
Type=simple
ExecStart=/usr/local/sbin/adsb-readsb
Restart=on-failure
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/readsb
RuntimeDirectory=readsb
RuntimeDirectoryMode=0755
DeviceAllow=/dev/bus/usb rwm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
