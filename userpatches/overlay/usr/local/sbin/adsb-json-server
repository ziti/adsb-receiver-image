#!/usr/bin/python3
"""Serve readsb's documented JSON files without an administration surface."""

from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
from urllib.parse import urlsplit

CONFIG = Path("/etc/adsb-receiver/config.json")
JSON_ROOT = Path("/run/readsb")
ALLOWED = {"aircraft.json", "receiver.json", "stats.json"}


class Handler(BaseHTTPRequestHandler):
    server_version = "adsb-json/1"

    def do_HEAD(self):
        self.serve(False)

    def do_GET(self):
        self.serve(True)

    def serve(self, body: bool) -> None:
        path = urlsplit(self.path).path
        name = path.removeprefix("/data/") if path.startswith("/data/") else path.removeprefix("/")
        if name not in ALLOWED:
            self.send_error(404)
            return
        source = JSON_ROOT / name
        try:
            data = source.read_bytes()
            json.loads(data)
        except (OSError, json.JSONDecodeError):
            self.send_error(503, "readsb data is not ready")
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if body:
            self.wfile.write(data)

    def log_message(self, fmt, *args):
        print("adsb-json:", self.command, urlsplit(self.path).path, args[1])


def main() -> None:
    config = json.loads(CONFIG.read_text())
    listener = config["listeners"]["jsonHttp"]
    if not listener["enabled"]:
        raise SystemExit(0)
    ThreadingHTTPServer((listener["address"], listener["port"]), Handler).serve_forever()


if __name__ == "__main__":
    main()
